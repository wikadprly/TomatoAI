# Salin file ini menjadi `.env` lalu sesuaikan.
# Jangan commit file `.env` yang berisi kredensial sungguhan.

# Lokasi file bobot MobileNetV2 hasil training.
MODEL_PATH=models/mobilenetv2_tomat.keras

# Ukuran input model. Harus sama dengan ukuran saat training.
IMAGE_SIZE=224

# Folder dataset.
DATASET_DIR=datasets

# Batas ukuran upload gambar dalam bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# Origin frontend yang boleh mengakses API, pisahkan dengan koma.
CORS_ORIGINS=http://localhost:3000