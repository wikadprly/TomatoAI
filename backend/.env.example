# Salin file ini menjadi `.env` lalu sesuaikan.
# Jangan commit file `.env` yang berisi kredensial sungguhan.

# Lokasi file bobot MobileNetV2 hasil training.
MODEL_PATH=models/mobilenetv2_tomat.keras

# Ukuran input model. Harus sama dengan ukuran saat training.
IMAGE_SIZE=224

# Input model dari hasil pengolahan citra:
#   original = citra asli 224 (default, distribusi training)
#   crop     = potong bbox tomat + margin (dari resolusi penuh)
#   segment  = citra hasil masking (latar hitam)
# Jalankan scripts/evaluate_input_modes.py dulu sebelum mengganti default.
INFERENCE_INPUT_MODE=original
CROP_MARGIN_RATIO=0.15

# Folder dataset.
DATASET_DIR=datasets

# Batas ukuran upload gambar dalam bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# Origin frontend yang boleh mengakses API, pisahkan dengan koma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Guard "khusus tomat" (heuristic, bukan model) ---
# Set 0 untuk mematikan bila terlalu ketat.
TOMATO_GUARD_ENABLED=1
MIN_OBJECT_RATIO=0.03
MAX_OBJECT_RATIO=0.85
MIN_CIRCULARITY=0.45
MIN_FILL_RATIO=0.60
MIN_SOLIDITY=0.80
MIN_ASPECT_RATIO=0.55
MAX_ASPECT_RATIO=1.80
MIN_MODEL_CONFIDENCE=0.55
MIN_CONFIDENCE_MARGIN=0.15